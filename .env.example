NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bugpilot

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate strong secrets in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption for project test credentials (32-byte hex or 32-char string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# AI service (internal only)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=change-me-internal-ai-service-secret
# AI: local, openai, or Groq Cloud (https://console.groq.com)
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# QA Health Score (transparent, product-defined — not an industry standard)
HEALTH_SCORE_CRITICAL_BUG_PENALTY=10
HEALTH_SCORE_HIGH_BUG_PENALTY=5
HEALTH_SCORE_API_FAILURE_PENALTY=4
HEALTH_SCORE_A11Y_PENALTY=3
HEALTH_SCORE_CONTENT_PENALTY=2
HEALTH_SCORE_PERF_PENALTY=2
HEALTH_SCORE_PASS_RATE_BONUS=7
